# 0125 release
#computed from datc4 and datc8


## Oddballs in CD4s
#now restrict to productive to avoid V only and OOF, also to full ab pair
apair4_paste(datc4$alpha.vgene, datc4$alpha.jgene, sep=".")
apair4s.cnt_table(apair4)		#restricts apair4s discovery to full productive on both chains
apair4s.cnt[apair4s.cnt>1000]_1000		#to keep the iNKT in plotting frame
apair4s_names(apair4s.cnt)
apair4s.main3p_rep(0, length(apair4s))		#the proportion represented by the main  CDR3 associated with each VaJa pair
for(i in 1:length(apair4s)) {y_table(datc4$alpha.junction[apair4==apair4s[i]])
									apair4s.main3p[i]_round(max(y)/sum(y), digits=3)}
#same CD8
#now restrict to productive to avoid V only and OOF, also to full ab pair
apair8_paste(datc8$alpha.vgene, datc8$alpha.jgene, sep=".")
apair8s.cnt_table(apair8)		#restricts apair8s discovery to full productive on both chains
apair8s.cnt[apair8s.cnt>1000]_1000		#to keep the iNKT in plotting frame
apair8s_names(apair8s.cnt)
apair8s.main3p_rep(0, length(apair8s))		#the proportion represented by the main  CDR3 associated with each VaJa pair
for(i in 1:length(apair8s)) {y_table(datc8$alpha.junction[apair8==apair8s[i]])
									apair8s.main3p[i]_round(max(y)/sum(y), digits=3)}
									
plot(apair4s.cnt, apair4s.main3p, pch=".", xlim=c(0, 500), ylim=c(0,1), xlab="VaJa pair occurence in CD4", ylab="Frequency of most abundant CDR3 in CD4")
z_(apair4s.cnt>100 & apair4s.main3p>0.15) | (apair4s.cnt>50 & apair4s.main3p>0.3)
plot(apair4s.cnt, apair4s.main3p, xlim=c(0, 500), ylim=c(0,1), pch=".", xlab="VJ pair occurence in CD4", ylab="Frequency of most abundant CDR3 for VJ pair in CD4")
text(apair4s.cnt[z]+5, apair4s.main3p[z], apair4s[z], adj=0, cex=0.5)


plot(apair8s.cnt, apair8s.main3p, pch=".", xlim=c(0, 500), ylim=c(0,1), xlab="VaJa pair occurence in CD8", ylab="Frequency of most abundant CDR3 in CD8")
z_(apair8s.cnt>100 & apair8s.main3p>0.15) | (apair8s.cnt>50 & apair8s.main3p>0.3)
plot(apair8s.cnt, apair8s.main3p, xlim=c(0, 500), ylim=c(0,1), pch=".", xlab="VJ pair occurence in CD8", ylab="Frequency of most abundant CDR3 for VJ pair in CD8")
text(apair8s.cnt[z]+5, apair8s.main3p[z], apair8s[z], adj=0, cex=0.5)


## Compute the max CDR3 freq in 4s and 8s for the same apairs
#use general apairs
res_matrix(0, length(apairs), 4)
colnames(res)_c("N4", "Fmax3.4", "N8", "Fmax3.8")
for (i in 1:length(apairs)) {
		x_apair4==apairs[i]
	res[i,1]_sum(x)
	y_table(datc4$alpha.junction[x])
	res[i,2]_round(max(y)/sum(y), digits=3)
		x_apair8==apairs[i]
	res[i,3]_sum(x)
	y_table(datc8$alpha.junction[x])
	res[i,4]_round(max(y)/sum(y), digits=3)
}
 plot(res[,1], res[,2]); plot(res[,3], res[,4]) 
par(fin=c(8,8))
plot(res[,1], res[,3], xlab="VaJa usage in CD4s", ylab="VaJa usage in CD8s")
plot(res[,2], res[,4], xlab="Freq of dominant CDR3 in CD4s", ylab="Freq of dominant CDR3 in CD8s")
z_res[,1]>70 & res[,3]>50
plot(res[z,2], res[z,4], xlim=c(0, 0.45), ylim=c(0, 0.45), xlab="Freq of dominant CDR3 in CD4s", ylab="Freq of dominant CDR3 in CD8s")
lines(c(0,0.45), c(0.1, 0.1)); lines(c(0.1, 0.1), c(0,0.45)) 
plot(res[z,2], res[z,4], pch=".", xlim=c(0, 0.45), ylim=c(0, 0.45) ,xlab="Freq of dominant CDR3 in CD4s", ylab="Freq of dominant CDR3 in CD8s")
text(res[z,2]+0.005, res[z,4], apairs[z], cex=0.5, adj=0)

z_res[,3]>50 &res[,4]>0.15
plot(res[,1], res[,2])
points(res[z,1], res[z,2], col=3, pch=16)
title(main="CD8 oddballs on the CD4 graph")
z_res[,1]>75 &res[,2]>0.15
plot(res[,3], res[,4])
points(res[z,3], res[z,4], col=2, pch=16)
title(main="CD4 oddballs on the CD8 graph")

## Plot oddballs from odb.char
z_odb.char0125$CD8 >110 | odb.char0125$CD4 >120
par(fin=c(8,8))
plot(odb.char0125$CD8, odb.char0125$CD4, xlab="Oddballs in CD8+ T", ylab="Oddball in CD4+ T") 
plot(odb.char0125$CD8, odb.char0125$CD4, pch=".", xlab="Oddballs in CD8+ T", ylab="Oddball in CD4+ T")
text(odb.char0125$CD8[z]+2, odb.char0125$CD4[z], odb.char0125$VaJa[z], cex=0.6, adj=0)

## Plot oddballs from odb.char
z_odb.char0125$Treg >28 
plot(odb.char0125$Treg, odb.char0125$CD4, pch=".", xlab="Oddballs in Treg", ylab="Oddball in CD4+ T")
text(odb.char0125$Treg[z]+0.5, odb.char0125$CD4[z], odb.char0125$VaJa[z], cex=0.6, adj=0)

