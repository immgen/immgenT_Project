### Progress through IGT (collapsed mode), see how repertoire increases with added mice
#use the LN list of clonotypes in each IGT; remove if <500  and (shuffle to avoid the weight of "norma;l" IGTs at the start
#filtering already done

res_matrix(0, length(LN), 3); colnames(res)_c("N", "Unique", "Chao1")
for (i in 1:length(LN)) {x_unlist(LN[1:i])
	x_table(x)
	res[i,1]_sum(x)
	res[i,2]_length(x)
	res[i,3]_chao1(x)
}
par(fin=c(8,8))
plot(res[,1], res[,2], pch=".", xlim=c(0, 140000), ylim=c(0, 140000))
lines(c(0, 140000), c(0, 140000))
par(mfrow=c(1,1))
plot(res[,1], res[,3], pch=16, log="y", ylim=c(10^4, 10^10), xlab="Nb of cells", ylab="Chao1 estimate")







