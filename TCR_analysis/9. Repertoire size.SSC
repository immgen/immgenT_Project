# 9. Full repetoire size
# Try to get an estimate of the complete repertoire size, across normal IGTs
# Use datntr

#define chao1 function
chao1 <- function(abundances) {
  # abundances: numeric vector of species/OTU counts 
S_obs <- sum(abundances > 0)           # Number of observed species
F1 <- sum(abundances == 1)             # Singletons
F2 <- sum(abundances == 2)             # Doubletons
  if (F2 > 0) {chao1.estimate <- S_obs + (F1^2) / (2 * F2)}
  else  {chao1.estimate <- S_obs + (F1 * (F1 - 1)) / (2 * (F2 + 1))  }
  return(chao1.estimate) }

## Test this Chao1 function on spleen from igt789 data (dat1 from OneMouse)
w_table(abN1[dat1$sample.name=="spleen"])
chao1(w)
#################


## Select all LN and spleen in dat.ntr (remove NOD and sorted TCRs, also 102/103 KOs
# then remove the second of the "same sample" IGTs (IGT10/11 13/14, etc - from Ian table) - from first tests, including them tended to drop the repertoire size, since
### DEV could use both duplicates, removing clonal expansions common to both, but easier just to drop half
# also weed out the infected, mutant  (scurfy) or aged samples: use a manually-curated list baseline.SLO.samps
# Finally remove the samples that contribute less than 500

x_unique(datntr$organ)
x_x[regexpr("node", x)>0 | regexpr("LN", x)>0  | x =="spleen" ]
z_is.element(datntr$organ, x)  & datntr$alpha.functionality=="productive" & datntr$beta.functionality=="productive" & regexpr("NOD", datntr$sample.name)<0 & is.element(datntr$IGT, c("IGT70", "IGT85", "IGT102", "IGT103"))==F
z_z & is.element(datntr$IGT, c("IGT11", "IGT14", "IGT16", "IGT18", "IGT21", "IGT72", "IGT92", "IGT98", "IGT101"))==F 
z_z & is.element(datntr$sample.name, baseline.SLO.samps)==T
x_table(paste(datntr$IGT[z], datntr$sample.name[z], sep="/")); x_as.character(names(x))[x>500]
