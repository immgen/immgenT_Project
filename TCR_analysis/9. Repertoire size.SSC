## Second: remove clonal expansions collapse the within-IGT clonal expansions (nucleotide-level) 		>>> Severe, as it could remove public specificities present in several copies in one mouse (or pool)
#make lists (LN, LP) of unique clonotypes in each IGT, then merge all that 
#same z selection as above
y_unique(datntr$IGT[z])
LN_LP_vector("list", length(y))
for (i in 1:length(y)) {LN[[i]]_unique(abN.ntr[z & datntr$IGT==y[i]])
							LP[[i]]_unique(abP.ntr[z & datntr$IGT==y[i]]) }
							#remove the IGT that contribute too few TCRs  (tend to be biased)
x_rep(0,length(LN)); for (i in 1:length(x)) x[i]_length(LN[[i]])
x_x>500; LN_LN[x]; LP_LP[x]

abNc.ntr_unlist(LN)
abPc.ntr_unlist(LP)
length(abNc.ntr); length(abPc.ntr)

chao1(table(abNc.ntr))
chao1(table(abPc.ntr))
y_sort(table(abNc.ntr)); x_(1:length(y)); y_y[x>90000]; x_x[x>90000] 
