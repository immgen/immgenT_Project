## Look at the same in non-productive VaJa joins (biased, since by definition cannot be the same as the oddball one)
#take the non-productive second chains from datc
x_datc$alpha2.functionality=="unproductive"
apair.np_paste(datc$alpha2.vgene[x], datc$alpha.jgene[x], sep=".")
apairs.np.cnt_table(apair.np)		#restricts apairs.np discovery to full productive on both chains
apairs.np.cnt[apairs.np.cnt>1000]_1000		#to keep the iNKT in plotting frame
apairs.np_names(apairs.np.cnt)
apairs.np.main3p_rep(0, length(apairs.np))		#the proportion represented by the main  CDR3 associated with each VaJa pair
for(i in 1:length(apairs.np)) {y_table(datc$alpha2.junction[x][apair.np==apairs.np[i]])
									apairs.np.main3p[i]_round(max(y)/sum(y), digits=3)}

plot(apairs.np.cnt, apairs.np.main3p, pch=".", xlim=c(0, 120), ylim=c(0,1), xlab="VaJa pair occurence in unproductive alpha2", ylab="Frequency of most abundant CDR3, non-productive")
							
#plot true oddballs onto the np plot
x_(apairs.cnt>150 & apairs.main3p>0.1) | (apairs.cnt>50 & apairs.main3p>0.25)
z_is.element(apairs.np, apairs[x])
plot(apairs.np.cnt, apairs.np.main3p, xlim=c(0, 120), ylim=c(0,1), pch=".", xlab="VJ pair occurence in unproductive alpha2", ylab="Frequency of most abundant CDR3 for VJ pair")
points(apairs.np.cnt[z], apairs.np.main3p[z], pch=16)

#compare directly main cdr3 freq in normal and non-productive (both selectied for high reads
z_match(apairs, apairs.np, nomatch=0)
plot(apairs.cnt[z>0], apairs.np.cnt[z], pch="."); title(main="VaJa usage in normal vs non-prod alphas")
plot(apairs.main3p[z>0], apairs.np.main3p[z], pch="."); title(main="dominant cdr3 frequency in normal vs non-prod alpha VJ pairs")

z_match(apairs[apairs.cnt>100], apairs.np[apairs.np.cnt>20], nomatch=0)
plot(apairs.main3p[apairs.cnt>100][z>0], apairs.np.main3p[apairs.np.cnt>20][z])
title(main="dominant cdr3 frequency in normal vs non-prod alpha VJ pairs, higher freqs only", cex.main=1)
lines(c(0.1, 0.1), c(0, 0.6)); lines(c(0, 0.8), c(0.2, 0.2))


					

