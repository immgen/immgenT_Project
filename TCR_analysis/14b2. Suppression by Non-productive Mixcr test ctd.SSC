#14 Suppression, compare CellRanger vs MIXCR output in IGT19, continued

## run the nonprod/prod table in several sets:

#assumes that 19 and 19x have been trimmed to where all beta are productive, and all matched

###where beta2 is unproductive in 19, irrespective of 19x		>>> first findings
z_ dat19$beta2.functionality=="unproductive" 

w_dat19[z,]
rm(vb.npppair.19)
vb.npppair.19_matrix(0, length(Vb), length(Vb)) 
colnames(vb.npppair.19)_rownames(vb.npppair.19)_Vb
n_rep(0, length(Vb))
for ( i in 1:length(Vb)) { x_w$beta2.vgene==Vb[i]
	n[i]_sum(x)
	for ( j in 1:length(Vb)) { y_w$beta.vgene[x]==Vb[j]
		vb.npppair.19[i,j]_round(100*sum(y)/sum(x), digits=1)
	}}
	pct_round(100*n/sum(n),digits=1)
vb.npppair.19_data.frame(n, pct, vb.npppair.19, stringsAsFactors=F)
sum(z)
vb.npppair.19

