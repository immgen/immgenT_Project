plot(x,y, pch=16, xlim=c(0,12), ylim=c(0,12), xlab="Vb in CD4 (%)", ylab="Vb in CD8 (%)"); lines(c(0, 12), c(0,12)); title(main="Vb CD4 vs CD8")
