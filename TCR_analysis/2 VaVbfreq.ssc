## Plot effects of 4/8 selection on Vb, relative to DPs
par(fin=c(8,8))
x_Vb.freq.tab$TotDPs
y_Vb.freq.tab$CD4
z4_Vb.freq.tab[,11]>1; z8_Vb.freq.tab[,11]<(-1)
#plot(x,y, pch=16, xlab="Vb in TotDPs (%)", ylab="Vb in CD4 (%)"); lines(c(0, 8), c(0,8)); title(main="Vb in pre-selection DPs vs CD4")
plot(x,y, pch=".", xlab="Vb in TotDPs (%)", ylab="Vb in CD4 (%)"); lines(c(0, 8), c(0,8)); title(main="Vb in pre-selection DPs vs CD4")
points(x[z4], y[z4], col=2, pch=16); points(x[z8], y[z8], col=3, pch=16)
text(x+0.1, y, Vb, adj=0, cex=0.6)

x_Vb.freq.tab$TotDPs
y_Vb.freq.tab$CD8
#plot(x,y, pch=16, xlab="Vb in TotDPs (%)", ylab="Vb in CD8 (%)"); lines(c(0, 8), c(0,8)); title(main="Vb in pre-selection DPs vs CD8")
plot(x,y, pch=".", xlab="Vb in TotDPs (%)", ylab="Vb in CD8 (%)"); lines(c(0, 8), c(0,8)); title(main="Vb in pre-selection DPs vs CD8")
points(x[z4], y[z4], col=2, pch=16); points(x[z8], y[z8], col=3, pch=16)
text(x+0.1, y, Vb, adj=0, cex=0.6)

