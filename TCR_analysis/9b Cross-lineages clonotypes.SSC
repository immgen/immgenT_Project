# Plot IGT70 shared clonos across time points
bckgd_igt1.96.sampled.20K.MDE.20250316
par(fin=c(8,8), cex.main=0.8)
k_"IGT70"
tm_c("D7", "D21")
z_is.element(abP.ntr, IGT70CD4TregSharingTab$clono) & datntr$IGT=="IGT70"
for (i in 1:length(tm)) {  z1_regexpr(tm[i], datntr$sample.name[z])>0
						plot(bckgd$mdeX, bckgd$mdeY, pch=".", col=16)
						points(datntr$umapXi.v2[z][z1], datntr$umapYi.v2[z][z1], pch=".", col=5)
						title(main=paste("CD4/Treg shared clonotypes," , k, tm[i]))
					}

# Same plots of IGT70 but down-sampled to 6 cells for each clonotype
bckgd_igt1.96.sampled.20K.MDE.20250316
par(fin=c(8,8), cex.main=0.8)
k_"IGT70"
tm_c("D7", "D21")
z_is.element(abP.ntr, IGT70CD4TregSharingTab$clono) & datntr$IGT=="IGT70"
for (i in 1:length(tm)) {  z_datntr$IGT==k
								z_z & regexpr(tm[i], datntr$sample.name)>0
								z1_0 #initialize
								w_regexpr(tm[i], colnames(IGT70CD4TregSharingTab))>0
								w_(1:nrow(IGT70CD4TregSharingTab))[rowSums(IGT70CD4TregSharingTab[,w])>0]	#select clonos by time
	for (j in w) { x_(1:nrow(datntr)) [z & abP.ntr==IGT70CD4TregSharingTab$clono[j] ]
						z1_c(z1, sample(x,size=min(6, length(x)), replace=F)) }
						plot(bckgd$mdeX, bckgd$mdeY, pch=".", col=16)
						points(datntr$umapXi.v2[z1], datntr$umapYi.v2[z1], pch=".", col=5)
						title(main=paste("CD4/Treg shared clonotypes," , k, tm[i]))
					}

###Any match in the IGT70 CD4/Treg clonotypes and the Jacobsen/Victora TCRs (Scence 2021)
#Sup table imported as VictoraSci2021TCRs.Fig4LateGCs

#search for matching beta.vegene and beta.junction
#beta.clonotypes in IGT70, retrieved from IGT70CD4TregSharingTab
x_is.element(abP.ntr, IGT70CD4TregSharingTab$clono)
table(datntr$IGT[x])	#all are in IGT70 within immgenT data
y_paste(datntr$beta.vgene[x], datntr$beta.junction[x], sep=".")
w_paste(VictoraSci2021TCRs.Fig4LateGCs$beta.vgene, VictoraSci2021TCRs.Fig4LateGCs$beta.junction, sep=".")
length(intersect(y,w))
