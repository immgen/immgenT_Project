## To analyze the TCRs in the A, E and KO , adapted for IGT102/103 in 0125 release, moved to 0725
#remove Va simplification (already in dat)
#no data error here
# inherits complete "dat" and "annot" from 1.Dataprep
# also inherits Va and Vb vectors of V regions, and the simplification process from 2.
## Parallel to same script for IGT91-92. All objects are un-numbered if from 102-103, others have 9192 suffix


datae_dat[is.element(dat$IGT, c("IGT102", "IGT103")) & is.element(dat$sample.name, c("A", "E", "O")),]

# Reduce to productive only
z_datae$alpha.functionality=="productive" & datae$beta.functionality=="productive"
sum(z)
datae_datae[z,]


# sample.type ### CAUTION: HARDCODED TO FIT 102/103 sample names
datae$sample.name_substituteString("_", ".", datae$sample.name)
samp.ae_datae$sample.name
samp.type_rep("A", nrow(datae))
samp.type[regexpr("E", samp.ae)>0]_"E"
samp.type[regexpr("O", samp.ae)>0]_"KO"
samp.types_sort(unique(samp.type))						# use samp.types in this variant


## Export E, A and EA table for Brinda/Tally 	### Remove the most extremely biased Va and Vb, not sure one should... 
												### CAUTION: adapted for the new release structure (no clonotypes)
w_c(5, 7:10, 21:24)
z_is.element(substring(datae$beta.vgene, 5,), c("3", "12-1", "12-2", "15", "16", "23"))
z_z | is.element(substring(datae$alpha.vgene, 5,), c("9-4", "9-1", "7-2", "11"))
dat.a_datae[samp.type=="A" & z==F, w]
dat.e_datae[samp.type=="E"& z==F, w]
dat.a.all_datae[samp.type=="A", w]
dat.e.all_datae[samp.type=="E", w]

## Are there shared clonotypes (protein level, both chains) between A and E datasets?
x_paste(datae$alpha.vgene, datae$alpha.junction, datae$beta.vgene, datae$beta.junction, sep=".")
sum(is.element(x[samp.type=="A"], x[samp.type=="E"]))
## RESULT: zero clonotypes shared between A and E samples


## iNKT in A and E
z_datae$alpha.vgene=="TRAV11" & datae$alpha.jgene=="TRAJ18" & samp.type=="E"
sum(z)
sum(samp.type=="E")
table(datae$beta.vgene[z])
table(datae$alpha.junction[z])


###

#VJ pairs
aVJae_paste(datae$alpha.vgene, datae$alpha.jgene, sep=".")			#vectors of VJ, length(dat)
bVJae_paste(datae$beta.vgene, datae$beta.jgene, sep=".")

## Make TRAV and TRBV matrices, one column for each sample.name
Va.ae_matrix(0, length(Va), length(samp.types))
Vb.ae_matrix(0, length(Vb), length(samp.types))
rownames(Va.ae)_Va; colnames(Va.ae)_samp.types
rownames(Vb.ae)_Vb; colnames(Vb.ae)_samp.types

for (i in 1:length(Va)) {
	for (j in 1:length(samp.types)) {Va.ae[i,j]_sum(datae$alpha.vgene==Va[i] & samp.type==samp.types[j])
	}}

for (i in 1:length(Vb)) {
	for (j in 1:length(samp.types)) {Vb.ae[i,j]_sum(datae$beta.vgene==Vb[i] & samp.type==samp.types[j])
	}}
Va.ae.freq_round(t(t(Va.ae)/colSums(Va.ae)*100), digits=1); Va.ae.freq_Va.ae.freq[,order(samp.types)]
Vb.ae.freq_round(t(t(Vb.ae)/colSums(Vb.ae)*100), digits=1); Vb.ae.freq_Vb.ae.freq[,order(samp.types)]


par(fin=c(8,8))
x_rowMeans(Va.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Va.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
#w_rowMeans(Va.ae[,samp.types=="EA"]); w_round(w/sum(w)*100, digits=1)
plot(x,y,pch=".", xlab="Va Freq in A", ylab="Va Freq in E")
#points(x,w, col=3)
x_rowMeans(Vb.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Vb.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
#w_rowMeans(Va.ae[,samp.types=="EA"]); w_round(w/sum(w)*100, digits=1)
y[8]_0.6	# te separate TRBV15 and 16
plot(x,y,pch=".", xlab="Vb Freq in A", ylab="Vb Freq in E", xlim=c(0,14), ylim=c(0,14))
plot(x,y,pch=".", xlab="Vb Freq in A", ylab="Vb Freq in E", xlim=c(0,14), ylim=c(0,14))
text(x+0.2,y,rownames(Vb.ae), cex=0.7, adj=0)
#points(x,w, col=3)

## mva-like plots
#E vs A
par(mfrow=c(1,1))
x_rowMeans(Va.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Va.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
plot((x+y)/2, (y+0.05)/(x+0.05), pch=".", log="y", ylim=c(0.05,20), xlab="MeanVa frequency", ylab="Va E/A ratio")
text(((x+y)/2)+0.05, (y+0.05)/(x+0.05), rownames(Va.ae), cex=0.7, adj=0)
lines(c(0,6), c(1,1)); title(main="Differential I-E/I-A Va usage")
#same, Vb
x_rowMeans(Vb.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Vb.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
y[8]_0.35
plot((x+y)/2, (y+0.05)/(x+0.05), pch=".", log="y", ylim=c(0.05,20), xlab="Mean Vb frequency", ylab="Vb E/A ratio")
text(((x+y)/2)+0.05, (y+0.05)/(x+0.05), rownames(Vb.ae), cex=0.7, adj=0)
lines(c(0,12), c(1,1)); title(main="Differential I-E/I-A Vb usage")


### Permutation test of the Va and Vb usage differences
#Va
#first select the Va with reasonable frequencies (>2%)
x_ rowMeans(Va.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Va.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
topVa_rownames(Va.ae)[((x+y)/2)>2]

z_samp.type=="A" | samp.type=="E"
w_samp.type[z]
X_datae$alpha.vgene[z]
x_table(X[w=="A"]); x_x/sum(x); x_x[match(topVa, names(x), nomatch=0)]
y_table(X[w=="E"]); y_y/sum(y); y_y[match(topVa, names(y), nomatch=0)]
topVa.earat_y/x

#now randomize
iter_100
res_matrix(0, length(topVa), iter)
for (k in 1:iter){z_sample(w)
x_table(X[z=="A"]); x_x/sum(x); x_x[match(topVa, names(x), nomatch=0)]
y_table(X[z=="E"]); y_y/sum(y); y_y[match(topVa, names(y), nomatch=0)]
res[,k]_y/x }
w_pnorm(topVa.earat, mean=mean(res), sd=stdev(res)); w_rowMins(cbind(w, 1-w))
w_w*length(topVa)		#Bonferroni correction
w_(-log10(w));
w[w<1.4]_0
topVa.earat_data.frame(topVa, as.numeric(round(topVa.earat, digits=3)), round(w, digits=2), stringsAsFactors=F)
topVa.earat_topVa.earat[order(topVa.earat[,2]),]; colnames(topVa.earat)_c("TRAV", "EtoA ratio", "-log10(padj)")

#Same, Vb
#first select the Vb with reasonable frequencies (>2%)
x_ rowMeans(Vb.ae[,samp.types=="A"]); x_round(x/sum(x)*100, digits=1); y_rowMeans(Vb.ae[,samp.types=="E"]); y_round(y/sum(y)*100, digits=1)
topVb_rownames(Vb.ae)[((x+y)/2)>2]
z_samp.type=="A" | samp.type=="E"
w_samp.type[z]
X_datae$beta.vgene[z]
x_table(X[w=="A"]); x_x/sum(x); x_x[match(topVb, names(x), nomatch=0)]
y_table(X[w=="E"]); y_y/sum(y); y_y[match(topVb, names(y), nomatch=0)]
topVb.earat_y/x
iter_100
res_matrix(0, length(topVb), iter)
for (k in 1:iter){z_sample(w)
x_table(X[z=="A"]); x_x/sum(x); x_x[match(topVb, names(x), nomatch=0)]
y_table(X[z=="E"]); y_y/sum(y); y_y[match(topVb, names(y), nomatch=0)]
res[,k]_y/x }
w_pnorm(topVb.earat, mean=mean(res), sd=stdev(res)); w_rowMins(cbind(w, 1-w))
w_w*length(topVb)		#Bonferroni correction
w_(-log10(w));
w[w<1.4]_0
topVb.earat_data.frame(topVb, as.numeric(round(topVb.earat, digits=3)), round(w, digits=2), stringsAsFactors=F)
topVb.earat_topVb.earat[order(topVb.earat[,2]),]; colnames(topVb.earat)_c("TRBV", "EtoA ratio", "-log10(padj)")


### Analyze charact of survivor cells with deleted Vbs in E mice
EdelVb_ rownames(Vb.ae.freq)[(Vb.ae.freq[,2]/Vb.ae.freq[,1])<0.3]
EdelVb.A.cells_datae$IGT.cellID[is.element(datae$beta.vgene, EdelVb) & samp.type=="A"]                          
EdelVb.E.cells_datae$IGT.cellID[is.element(datae$beta.vgene, EdelVb) & samp.type=="E"] 

# Plot on mde
par(fin=c(8,8))
b_sample((1:nrow(GSE297097.mde.incremental.level1.All.data)), 20000)
za_is.element(GSE297097.mde.incremental.level1.All.data[,1], EdelVb.A.cells)
ze_is.element(GSE297097.mde.incremental.level1.All.data[,1], EdelVb.E.cells)
plot(GSE297097.mde.incremental.level1.All.data$X[b], GSE297097.mde.incremental.level1.All.data$Y[b], pch=".", col="lightgrey")
points(GSE297097.mde.incremental.level1.All.data$X[za], GSE297097.mde.incremental.level1.All.data$Y[za], pch=16, cex=0.6, col=2)
title(main="CD8- T cells expressing E+mtv-sensitive Vb in H2-A+ mice")
plot(GSE297097.mde.incremental.level1.All.data$X[b], GSE297097.mde.incremental.level1.All.data$Y[b], pch=".", col="lightgrey")
points(GSE297097.mde.incremental.level1.All.data$X[ze], GSE297097.mde.incremental.level1.All.data$Y[ze], pch=16, cex=0.6, col=5)
title(main="CD8- T cells expressing E+mtv-sensitive Vb in H2-E+ mice")

#cell-types (%%%%%% NOTE: 102/103 were sorted on CD8-, so increase in DNs not seen in 91.92  %%%%%%%%%%)
za_is.element(GSE297097.annotation.table.20250505.IGT1.104$IGT.cellID, EdelVb.A.cells)
ze_is.element(GSE297097.annotation.table.20250505.IGT1.104$IGT.cellID, EdelVb.E.cells)
x_table(GSE297097.annotation.table.20250505.IGT1.104$level1[za]);round(100*x/sum(x), digits=1)
x_table(GSE297097.annotation.table.20250505.IGT1.104$level1[ze]);round(100*x/sum(x), digits=1)


#compare Va and Jb
EdelVb.A.Va_EdelVb.E.Va_rep(0, length(Va))
x_datae$alpha.vgene[is.element(datae$beta.vgene, EdelVb) & samp.type=="A"]
y_datae$alpha.vgene[is.element(datae$beta.vgene, EdelVb) & samp.type=="E"]
for (i in 1:length(Va)) {EdelVb.A.Va[i]_sum(x==Va[i]); EdelVb.E.Va[i]_sum(y==Va[i])}
	par(fin=c(8,8))
plot(EdelVb.E.Va, EdelVb.A.Va, xlab="Va frequency in E+ Vb deletion survivors", ylab="Va frequency in A +")
plot(EdelVb.E.Va, EdelVb.A.Va, pch=".", xlab="Va frequency in E+ Vb deletion survivors", ylab="Va frequency in A +")
text(EdelVb.E.Va+0.1, EdelVb.A.Va, Va, cex=0.7, adj=0)

EdelVb.A.Jb_EdelVb.E.Jb_rep(0, length(Jb))
x_datae$beta.jgene[is.element(datae$beta.vgene, EdelVb) & samp.type=="A"]
y_datae$beta.jgene[is.element(datae$beta.vgene, EdelVb) & samp.type=="E"]
for (i in 1:length(Jb)) {EdelVb.A.Jb[i]_sum(x==Jb[i]); EdelVb.E.Jb[i]_sum(y==Jb[i])}
	par(fin=c(8,8))
plot(EdelVb.E.Jb, EdelVb.A.Jb, xlab="Jb nbs in E+ Vb deletion survivors", ylab="Jb nbs in A +")
plot((100*EdelVb.E.Jb/sum(EdelVb.E.Jb)), (100*EdelVb.A.Jb/sum(EdelVb.A.Jb)), pch=".", xlab="Jb frequency in E+ Vb deletion survivors", ylab="Jb frequency in A +")
text((100*EdelVb.E.Jb/sum(EdelVb.E.Jb)), (100*EdelVb.A.Jb/sum(EdelVb.A.Jb)), Jb, cex=0.7, adj=0)



