## iNKT check										
#verify the no iNKT observation, going back to IGT17 and 18 (which has 221 iNKT cells)
par(fin=c(8,8))
for (k in c("IGT17", "IGT18")) {
x_dat$umapX[dat$IGT==k]
y_dat$umapY[dat$IGT==k]	
w_dat$IGT.cellID[dat$IGT==k]
if (k=="IGT17") z_is.element(w, inkt.ids17)
if (k=="IGT18") z_is.element(w, inkt.ids18)
plot(x,y,pch=".", co=16)
points	(x[z], y[z], pch=16, col=5)
title(main=paste("iNKT in", k, "Thymus"))
}
#same MAIT
par(fin=c(8,8))
for (k in c("IGT17", "IGT18")) {
x_dat$umapX[dat$IGT==k]
y_dat$umapY[dat$IGT==k]	
w_dat$IGT.cellID[dat$IGT==k]
