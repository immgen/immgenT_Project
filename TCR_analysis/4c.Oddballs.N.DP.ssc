plot(odb.freqs.dp[,2]+10^(-6), odb.freqs.dp[,4]+10^(-6), type="n", log="xy", xlim=c(0.0000001, 0.003), ylim=c(0.0000001, 0.003), xlab="Canonic Frequency in whole datc", ylab="Canonic Frequency in 71-72 DPs")
text(odb.freqs.dp[,2]+10^(-6), odb.freqs.dp[,4]+10^(-6), 1:nrow(odb.char0125), cex=0.7)
text((odb.freqs.dp[,1]+10^(-6))[1:2], (odb.freqs.dp[,2]+10^(-6))[1:2], c("N", "M"), col=3, cex=0.8)
lines(c(0.0000001, 0.003), c(0.0000001, 0.003))

