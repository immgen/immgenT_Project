colnames(odb.freqs.dp)_c("Nb.VaJain10K.T", "Nb.canonic3In10K.T", "Nb.VaJain10K.DP", "Nb.canonic3in10K.DP")
rownames(odb.freqs.dp)_odb.char0125$VaJa
for (i in 1:nrow(odb.char0125)) {	z_is.element(apair, odb.char0125$VaJa[i])
										odb.freqs.dp[i,1]_sum(z)/length(z)
										z_is.element(apair, odb.char0125$VaJa[i]) & is.element(datc$alpha.junction, odb.char0125$MainAjunct[i])
										odb.freqs.dp[i,2]_sum(z)/length(z)
										z_is.element(apairx, odb.char0125$VaJa[i])
										odb.freqs.dp[i,3]_sum(z)/length(z)										
										z_is.element(apairx, odb.char0125$VaJa[i]) & is.element(x$alpha.junction, odb.char0125$MainAjunct[i])
										odb.freqs.dp[i,4]_sum(z)/length(z)
										}
