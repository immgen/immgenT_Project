## plot all other oddballs in thymus
par(fin=c(8,8))
for (k in c("IGT17", "IGT18")) {
x_dat[dat$IGT==k,]
apairx_paste(x$alpha.vgene, x$alpha.jgene, sep=".")
z_is.element(apairx, odb.char0125$VaJa[-c(1,2)]) & is.element(x$alpha.junction, odb.char0125$MainAjunct[-c(1,2)])		#remove 1 and 2 to leave out iNKT and Mait
x_dat$umapX[dat$IGT==k]
y_dat$umapY[dat$IGT==k]	
plot(x,y,pch=".", col=16)
points	(x[z], y[z], pch=16, col=5)
title(main=paste("All Oddballs in", k, "Thymus (no iNKT/MAIT)"))
}


##split Oddballs that do or don't make it in DPs (leave out iNKT and Maits			
zin_odb.freqs.dp$Nb.in10K.DP>0; zin[1:2]_F
zout_odb.freqs.dp$Nb.in10K.DP==0; zout[1:2]_F
for (k in c("IGT17", "IGT18")) {
X_dat[dat$IGT==k,]
apairx_paste(X$alpha.vgene, X$alpha.jgene, sep=".")
z_is.element(apairx, odb.char0125$VaJa[zin]) & is.element(X$alpha.junction, odb.char0125$MainAjunct[zin])		#first the oddballs that are present in DPs
x_X$umapX
y_X$umapY	
plot(x,y,pch=".", col=16)
points	(x[z], y[z], pch=16, col=2)
title(main=paste("DP+ Oddballs in", k, "Thymus (no iNKT/MAIT)"))
z_is.element(apairx, odb.char0125$VaJa[zout]) & is.element(X$alpha.junction, odb.char0125$MainAjunct[zout])		#first the oddballs that are present in DPs
plot(x,y,pch=".", col=16)
points	(x[z], y[z], pch=16, col=4)
title(main=paste("DP- Oddballs in", k, "Thymus (no iNKT/MAIT)"))
}












