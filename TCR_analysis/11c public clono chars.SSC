z_is.element(map$IGT.cellID, dt$IGT.cellID[x])
par(fin=c(8,8))
	plot(map$X[y], map$Y[y], pch=".", col=16)
	points(map$X[z], map$Y[z], pch=16, col=4)
	title(main=nm)


## Add Pgen probabilities to the rep.Pclonos 
# from OLGA computes off the 0126 SummaryTable in pGenAllData matrix

z_match(rep.Pclonos$Pclonos, all.Pclonos, nomatch=0)
z1_match(dt$IGT.cellID[z], pGenAllData$IGT.cellID, nomatch=0)
z2_match(dt$IGT.cellID, pGenAllData$IGT.cellID, nomatch=0)

test_data.frame(rep.Pclonos$Pclonos, all.Pclonos[z], dt$IGT.cellID[z], pGenAllData[z1,c(2,8,14)], stringsAsFactors=F)

#compare Pgen in publics vs whole
summary(pGenAllData$alpha.Pgen.nt[z1])
summary(pGenAllData$beta.Pgen.nt[z1])
summary(pGenAllData$alpha.Pgen.nt[z2], na.rm=T)
summary(pGenAllData$beta.Pgen.nt[z2][is.inf(pGenAllData$beta.Pgen.nt[z2])==F], na.rm=T)

x_pGenAllData$alpha.Pgen.nt[z1] [is.na(pGenAllData$alpha.Pgen.nt[z1])==F]
x_sample(x, 500)
y_pGenAllData$alpha.Pgen.nt[z2] [is.na(pGenAllData$alpha.Pgen.nt[z2])==F]
y_sample(y, 500)
(wilcox.test(x,y))$p.value

x_pGenAllData$beta.Pgen.nt[z1] [is.na(pGenAllData$beta.Pgen.nt[z1])==F]
x_sample(x, 500)
y_pGenAllData$beta.Pgen.nt[z2] [is.na(pGenAllData$beta.Pgen.nt[z2])==F & is.inf(pGenAllData$beta.Pgen.nt[z2])==F]
y_sample(y, 500)
(wilcox.test(x,y))$p.value
