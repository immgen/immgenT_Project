## Data cleanup
# use the "editBcheck.results" output from Liang (number of reads and UMIs over difference, for both c1 and c2
#table is per mutation, but they match
#Criteria: ce1l1 and cell2 must have 2 UMIs

editB.qual_data.frame(edit.B$cell1.ID, edit.B$cell2.ID, matrix(0, nrow(edit.B), 4), stringsAsFactors=F)
colnames(editB.qual)_c("cell1.ID", "cell2.ID", "cell1.Qreads", "cell1.UMI","cell2.Qreads", "cell2.UMI")
for (i in 1:nrow(edit.B)) {z_editBcheck.results$c1.id==edit.B$cell1.ID[i]
								editB.qual$cell1.Qreads[i]_mean(editBcheck.results$c1.matched.reads.Q20[z])
								editB.qual$cell1.UMI[i]_mean(editBcheck.results$c1.umis[z])
								editB.qual$cell2.Qreads[i]_mean(editBcheck.results$c2.matched.reads.Q20[z])
								editB.qual$cell2.UMI[i]_mean(editBcheck.results$c2.umis[z]) }

suspect_(editB.qual$cell1.Qreads<4 | editB.qual$cell1.UMI<2 | editB.qual$cell2.Qreads<4 | editB.qual$cell2.UMI<2)

edit.Bqc_data.frame(edit.B[,1:15], round(editB.qual[,3:6],digits=1), suspect, edit.B[18:23], stringsAsFactors=F)
edit.Bqc_edit.Bqc[order(edit.Bqc$suspect, edit.Bqc$IGTsamp),]



