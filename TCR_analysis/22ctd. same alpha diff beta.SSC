oneAtwoB_oneAtwoB[z==F,]

## How many of the alphas in oneAtwoB correspond to oddballs
#parse odb.char0125
xod_matrix("-", nrow(odb.char0125), 3)
x_strsplit(odb.char0125$VaJa,"\\.")
for (i in 1:nrow(xod)) {y_unlist(x[[i]])
								xod[i,1]_y[1]; xod[i,2]_y[2]}
xod[,3]_odb.char0125$MainAjunct

#match to oneAtwoB A clonoype (in X1)
isODB_rep(0, nrow(oneAtwoB))
for (i in 1:nrow(oneAtwoB)) {
	x_unlist(strsplit(oneAtwoB$X1[i], "\\."))
	z_is.element(xod[,1], x[1]) & is.element( xod[,3], x[3]) & is.element(xod[,2], x[4])
	isODB[i]_sum(z)>0
}	

oneAtwoB_data.frame(oneAtwoB[,1], isODB, oneAtwoB[,2:ncol(oneAtwoB)], stringsAsFactors=F)

				
