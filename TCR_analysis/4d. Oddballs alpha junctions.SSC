# Analysis of dominant alpha-junction.nt in oddballs
#Use odb.char0125


#plot of dominant frequencies
plot(odb.char0125$FreqMainAjunct, odb.char0125$FreqMainAnuc, ylim=c(0,1))



#Plot of alpha.junction.nuc proportion for each addball
par(mfrow=c(1,1))
plot(c(0,8), c(0,1), type="n", xlab="Rank", ylab="Frequency of each junction.nt")
text(0,0, "order in odb.char0125", adj=0, cex=0.6)
title(main="Distribution of alpha.junction.nt encoding oddballs")
#for (i in 1:nrow(odb.char0125)) {z_is.element(apair, odb.char0125$VaJa[i]) & is.element(datc$alpha.junction, odb.char0125$MainAjunct[i])
for (i in 1:30) {z_is.element(apair, odb.char0125$VaJa[i]) & is.element(datc$alpha.junction, odb.char0125$MainAjunct[i])	
					x_rev(sort(table(datc$alpha.junction.nt[z]))) 
					x_x/sum(x)
					points(1:length(x), x, type="b", col=i)
					text(runif(1, 0.2, 0.9), max(x), i, cex=0.5)
				}
					
#same, for dominant junctions predicted to have N
par(mfrow=c(1,1))
plot(c(0,8), c(0,1), type="n", xlab="Rank", ylab="junction.nt requency when dominant has N additions")
text(0,0, "order in odb.char0125", adj=0, cex=0.6)
title(main="Distribution of alpha.junction.nt encoding oddballs")
for (i in (1:nrow(odb.char0125))[odb.char0125$NdivinmainAnuc!=""]) {z_is.element(apair, odb.char0125$VaJa[i]) & is.element(datc$alpha.junction, odb.char0125$MainAjunct[i])
					x_rev(sort(table(datc$alpha.junction.nt[z]))) 
					x_x/sum(x)
					points(1:length(x), x, type="b", col=i)
					text(runif(1, 0.2, 0.9), max(x), i, cex=0.5)
					text(runif(1,7,8), max(x), odb.char0125$NdivinmainAnuc[i], cex=0.7, adj=0)
				}
				
## Make a table of all alpha variants for oddballs (other than iNKTand MAIT)
odb.anucs_data.frame(matrix("-", 2,2), rep(0,2), matrix("-", 2, 2), stringsAsFactors=F)
colnames(odb.anucs)_c("VaJa", "MainAjunct", "Ajunc.n.Nb", "Ajunc.n", "N")
for (i in (1:nrow(odb.char0125))) {z_is.element(apair, odb.char0125$VaJa[i]) & is.element(datc$alpha.junction, odb.char0125$MainAjunct[i])
						x_rev(sort(table(datc$alpha.junction.nt[z])))
						y_length(x)
						res_data.frame(matrix("-", y,2), rep(0,y), matrix("-", y,2), stringsAsFactors=F); colnames(res)_c("VaJa", "MainAjunct", "Ajunc.n.Nb", "Ajunc.n", "N")
						res[,1]_odb.char0125$VaJa[i]
						res[,2]_odb.char0125$MainAjunct[i]
						res[,3]_x
						res[,4]_names(x)
						for (j in 1:y) res[j,5]_paste(unique(datc$alpha.vj.nregion[z][datc$alpha.junction.nt==names(x)[j]]), collapse="/")
						odb.anucs_rbind(odb.anucs,res)
					}
		odb.anucs_odb.anucs[-(1:2),]
					
					
						
						
						

			
				